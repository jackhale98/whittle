{
  "name": "wren",
  "private": true,
  "version": "0.0.0",
  "description": "Free, open-source, browser-native parametric CAD.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @wren-cad/web dev",
    "build": "pnpm --filter @wren-cad/web build && node scripts/third-party-notices.mjs",
    "preview": "pnpm --filter @wren-cad/web preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check . && node scripts/check-file-sizes.mjs",
    "check:size": "node scripts/check-file-sizes.mjs",
    "format": "biome format --write .",
    "e2e": "pnpm --filter @wren-cad/web e2e",
    "perf": "pnpm --filter @wren-cad/web perf",
    "stress": "pnpm --filter @wren-cad/test-fixtures stress && pnpm --filter @wren-cad/web stress",
    "perf:viewport": "pnpm --filter @wren-cad/viewport perf",
    "kernel:build": "pnpm --filter @wren-cad/kernel build",
    "kernel:test": "pnpm --filter @wren-cad/kernel test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
