{
  "name": "@wren-cad/kernel",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "OCCT 8.0.1 → WebAssembly kernel with Wren's coarse C++ façade (built with @libcascade/toolchain). Sources are GPL-3.0-or-later; the produced .wasm/.js are LGPL-2.1-only WITH Open-CASCADE-Exception-1.0.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./single/init": {
      "types": "./dist/init.single.d.ts",
      "default": "./dist/init.single.js"
    },
    "./multi/init": {
      "types": "./dist/init.multi.d.ts",
      "default": "./dist/init.multi.js"
    },
    "./single/wasm": "./dist/whittle-kernel-st.wasm",
    "./multi/wasm": "./dist/whittle-kernel.wasm",
    "./single": {
      "types": "./dist/variant.d.ts",
      "default": "./dist/whittle-kernel-st.js"
    },
    "./multi": {
      "types": "./dist/variant.d.ts",
      "default": "./dist/whittle-kernel.js"
    },
    "./size-report.json": "./dist/size-report.json",
    "./drawing": "./src/drawing/index.ts",
    "./drawing/worker": "./src/drawing/worker.ts",
    "./drawing/single/init": {
      "types": "./drawing/dist/init.single.d.ts",
      "default": "./drawing/dist/init.single.js"
    },
    "./drawing/multi/init": {
      "types": "./drawing/dist/init.multi.d.ts",
      "default": "./drawing/dist/init.multi.js"
    },
    "./drawing/single/wasm": "./drawing/dist/wren-drawing-st.wasm",
    "./drawing/multi/wasm": "./drawing/dist/wren-drawing.wasm",
    "./drawing/size-report.json": "./drawing/dist/size-report.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:drawing": "node drawing/scripts/build.mjs",
    "size": "node scripts/size-report.mjs",
    "size:drawing": "node drawing/scripts/size-report.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@wren-cad/contracts": "workspace:*",
    "comlink": "4.4.2"
  },
  "devDependencies": {
    "@libcascade/toolchain": "3.1.0"
  }
}
