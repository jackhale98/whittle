{
  "name": "@wren-cad/viewport",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Imperative three.js viewport: WebGPU with WebGL2 fallback, camera-controls, fat-line edges.",
  "exports": {
    ".": "./src/index.ts",
    "./ids": "./src/ids.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "harness": "vite",
    "harness:build": "vite build",
    "e2e": "playwright test --trace off",
    "perf": "WREN_PERF=1 playwright test --trace off -g \"perf probe\"",
    "perf:assert": "WREN_PERF=1 WREN_PERF_ASSERT=1 playwright test --trace off -g \"perf probe\""
  },
  "dependencies": {
    "@wren-cad/contracts": "workspace:*",
    "camera-controls": "3.1.2",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.187.0",
    "@wren-cad/test-fixtures": "workspace:*",
    "vite": "8.3.6"
  }
}
