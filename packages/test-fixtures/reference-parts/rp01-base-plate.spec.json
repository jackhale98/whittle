{
  "schema": "wren-reference-part/1",
  "id": "rp01-base-plate",
  "no": 1,
  "title": "Base plate",
  "level": "CSWA-like",
  "summary": "A rectangular aluminium plate with four mounting holes, a central bore and a shallow pocket.",
  "units": {
    "length": "mm",
    "angle": "deg"
  },
  "material": {
    "libraryId": "whittle:aluminium-6061-t6",
    "name": "Aluminium 6061-T6",
    "density": "2.70 g/cm^3",
    "density_g_cm3": 2.7
  },
  "dimensions": {
    "length": {
      "value": 120,
      "unit": "mm",
      "description": "Plate length (X)"
    },
    "width": {
      "value": 80,
      "unit": "mm",
      "description": "Plate width (Y)"
    },
    "thickness": {
      "value": 12,
      "unit": "mm",
      "description": "Plate thickness (Z)"
    },
    "hole_d": {
      "value": 10,
      "unit": "mm",
      "description": "Diameter of the four mounting holes"
    },
    "hole_x": {
      "value": 45,
      "unit": "mm",
      "description": "Hole centres from the centre line, along X"
    },
    "hole_y": {
      "value": 25,
      "unit": "mm",
      "description": "Hole centres from the centre line, along Y"
    },
    "bore_d": {
      "value": 30,
      "unit": "mm",
      "description": "Central through bore diameter"
    },
    "pocket_w": {
      "value": 40,
      "unit": "mm",
      "description": "Pocket size along X"
    },
    "pocket_h": {
      "value": 14,
      "unit": "mm",
      "description": "Pocket size along Y"
    },
    "pocket_y": {
      "value": 20,
      "unit": "mm",
      "description": "Pocket near edge, measured from the centre line"
    },
    "pocket_d": {
      "value": 5,
      "unit": "mm",
      "description": "Pocket depth"
    }
  },
  "tags": [
    "extrude",
    "cut"
  ],
  "standards": [],
  "method": "Exact closed form: the plate is a box minus cylinders and one box pocket. The surface area is exact too. Accuracy is limited only by floating point (1e-12 relative).",
  "features": [
    {
      "tool": "sketch",
      "id": "base_sk",
      "say": "Sketch on Top (the XY plane): a rectangle length x width centred on the origin.",
      "on": {
        "pick": "plane",
        "name": "origin:XY"
      },
      "ops": [
        {
          "op": "rect",
          "id": "L",
          "x": "-length/2",
          "y": "-width/2",
          "w": "length",
          "h": "width"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "base",
      "say": "Extrude the rectangle by thickness, as a new body.",
      "profile": [
        {
          "pick": "region",
          "sketch": "base_sk",
          "curves": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "at": [
            50,
            30,
            0
          ]
        }
      ],
      "direction": "normal",
      "end": {
        "kind": "blind",
        "depth": "thickness"
      },
      "op": "new"
    },
    {
      "tool": "sketch",
      "id": "holes_sk",
      "say": "Sketch on the top face: four circles of hole_d at (+-hole_x, +-hole_y) and a bore_d circle at the origin.",
      "on": {
        "pick": "face",
        "name": "F{base}:end",
        "at": [
          50,
          30,
          12
        ]
      },
      "ops": [
        {
          "op": "circle",
          "id": "H1",
          "cx": "hole_x",
          "cy": "hole_y",
          "d": "hole_d"
        },
        {
          "op": "circle",
          "id": "H2",
          "cx": "-hole_x",
          "cy": "hole_y",
          "d": "hole_d"
        },
        {
          "op": "circle",
          "id": "H3",
          "cx": "-hole_x",
          "cy": "-hole_y",
          "d": "hole_d"
        },
        {
          "op": "circle",
          "id": "H4",
          "cx": "hole_x",
          "cy": "-hole_y",
          "d": "hole_d"
        },
        {
          "op": "circle",
          "id": "B",
          "cx": "0",
          "cy": "0",
          "d": "bore_d"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "holes",
      "say": "Cut-extrude the five circles through all, downwards.",
      "profile": [
        {
          "pick": "region",
          "sketch": "holes_sk",
          "curves": [
            "H1"
          ],
          "at": [
            45,
            25,
            12
          ]
        },
        {
          "pick": "region",
          "sketch": "holes_sk",
          "curves": [
            "H2"
          ],
          "at": [
            -45,
            25,
            12
          ]
        },
        {
          "pick": "region",
          "sketch": "holes_sk",
          "curves": [
            "H3"
          ],
          "at": [
            -45,
            -25,
            12
          ]
        },
        {
          "pick": "region",
          "sketch": "holes_sk",
          "curves": [
            "H4"
          ],
          "at": [
            45,
            -25,
            12
          ]
        },
        {
          "pick": "region",
          "sketch": "holes_sk",
          "curves": [
            "B"
          ],
          "at": [
            0,
            0,
            12
          ]
        }
      ],
      "direction": "reverse",
      "end": {
        "kind": "throughAll"
      },
      "op": "cut"
    },
    {
      "tool": "sketch",
      "id": "pocket_sk",
      "say": "Sketch on the top face: a pocket_w x pocket_h rectangle whose near edge is pocket_y from the centre line.",
      "on": {
        "pick": "face",
        "name": "F{base}:end",
        "at": [
          50,
          30,
          12
        ]
      },
      "ops": [
        {
          "op": "rect",
          "id": "P",
          "x": "-pocket_w/2",
          "y": "pocket_y",
          "w": "pocket_w",
          "h": "pocket_h"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "pocket",
      "say": "Cut-extrude the rectangle downwards by pocket_d.",
      "profile": [
        {
          "pick": "region",
          "sketch": "pocket_sk",
          "curves": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "at": [
            0,
            27,
            12
          ]
        }
      ],
      "direction": "reverse",
      "end": {
        "kind": "blind",
        "depth": "pocket_d"
      },
      "op": "cut"
    }
  ],
