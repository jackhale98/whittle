  "standards": [],
  "method": "Exact. Plate, ears and slots are boxes and the ear holes are cylinders. The slot pattern has slot_n instances; instance 3 is skipped, so slot_n - 1 slots are cut. The mirror copies the ear and its hole, so there are two of each. Accuracy: floating point (1e-12 relative). The surface area is the top and bottom faces plus the side walls (outer outline with the ears attached, slot walls, ear hole walls).",
  "features": [
    {
      "tool": "sketch",
      "id": "base_sk",
      "say": "Sketch on Top (XY): a rectangle plate_l x plate_w centred on the origin.",
      "on": {
        "pick": "plane",
        "name": "origin:XY"
      },
      "ops": [
        {
          "op": "rect",
          "id": "L",
          "x": "-plate_l/2",
          "y": "-plate_w/2",
          "w": "plate_l",
          "h": "plate_w"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "base",
      "say": "Extrude by plate_t as a new body.",
      "profile": [
        {
          "pick": "region",
          "sketch": "base_sk",
          "curves": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "at": [
            50,
            10,
            0
          ]
        }
      ],
      "direction": "normal",
      "end": {
        "kind": "blind",
        "depth": "plate_t"
      },
      "op": "new"
    },
    {
      "tool": "sketch",
      "id": "slot_sk",
      "say": "Sketch on Top: one slot, slot_l x slot_w, centred on y = 0 with its centre at slot_x0.",
      "on": {
        "pick": "plane",
        "name": "origin:XY"
      },
      "ops": [
        {
          "op": "rect",
          "id": "S",
          "x": "slot_x0 - slot_l/2",
          "y": "-slot_w/2",
          "w": "slot_l",
          "h": "slot_w"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "slot",
      "say": "Cut-extrude the slot through all (both ways from the sketch plane).",
      "profile": [
        {
          "pick": "region",
          "sketch": "slot_sk",
          "curves": [
            "S1",
            "S2",
            "S3",
            "S4"
          ],
          "at": [
            -45,
            0,
            0
          ]
        }
      ],
      "direction": "symmetric",
      "end": {
        "kind": "throughAll"
      },
      "op": "cut"
    },
    {
      "tool": "linearPattern",
      "id": "slots",
      "say": "Linear pattern of the slot along X: slot_n instances, spacing slot_pitch, skip instance 3.",
      "source": {
        "kind": "features",
        "features": [
          "slot"
        ]
      },
      "direction": {
        "pick": "axis",
        "name": "origin:X"
      },
      "reverse": false,
      "count": "slot_n",
      "spacing": "slot_pitch",
      "skip": [
        3
      ]
    },
    {
      "tool": "sketch",
      "id": "ear_sk",
      "say": "Sketch on Top: the +X ear, a rectangle ear_l x ear_w against the plate end.",
      "on": {
        "pick": "plane",
        "name": "origin:XY"
      },
      "ops": [
        {
          "op": "rect",
          "id": "E",
          "x": "plate_l/2",
          "y": "-ear_w/2",
          "w": "ear_l",
          "h": "ear_w"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "ear",
      "say": "Extrude the ear by plate_t, adding to the plate.",
      "profile": [
        {
          "pick": "region",
          "sketch": "ear_sk",
          "curves": [
            "E1",
            "E2",
            "E3",
            "E4"
          ],
          "at": [
            70,
            0,
            0
          ]
        }
      ],
      "direction": "normal",
      "end": {
        "kind": "blind",
        "depth": "plate_t"
      },
      "op": "add"
    },
    {
      "tool": "sketch",
      "id": "eh_sk",
      "say": "Sketch on Top: a circle of ear_hole_d at the centre of the ear.",
      "on": {
        "pick": "plane",
        "name": "origin:XY"
      },
      "ops": [
        {
          "op": "circle",
          "id": "C",
          "cx": "plate_l/2 + ear_l/2",
          "cy": "0",
          "d": "ear_hole_d"
        }
      ]
    },
    {
      "tool": "extrude",
      "id": "eh",
      "say": "Cut-extrude the circle through all (both ways).",
      "profile": [
        {
          "pick": "region",
          "sketch": "eh_sk",
          "curves": [
            "C"
          ],
          "at": [
            70,
            0,
            0
          ]
        }
      ],
      "direction": "symmetric",
      "end": {
        "kind": "throughAll"
      },
      "op": "cut"
    },
    {
      "tool": "mirror",
      "id": "mir",
      "say": "Mirror the ear and its hole about the Right plane (YZ).",
      "source": {
        "kind": "features",
        "features": [
          "ear",
          "eh"
        ]
      },
      "plane": {
        "pick": "plane",
        "name": "origin:YZ"
      }
    }
  ],
