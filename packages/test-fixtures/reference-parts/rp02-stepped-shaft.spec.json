  "standards": [],
  "method": "Exact. The blank is three cylinders. The fillet and the chamfer are corner pieces of a revolved profile, so Pappus gives their volumes: area of the cross-section times 2 pi times the radius of its centroid. The fillet gap area is (1 - pi/4) r^2 with its centroid 0.2234 r from both walls; the chamfer triangle has area c^2/2 and centroid c/3 from both legs. The surface area uses Pappus on each profile segment. Accuracy: floating point (1e-12 relative).",
  "features": [
    {
      "tool": "sketch",
      "id": "prof_sk",
      "say": "Sketch on Front (the XZ plane): the half profile of the shaft, from the axis out and back, closed along the axis.",
      "on": {
        "pick": "plane",
        "name": "origin:XZ"
      },
      "ops": [
        {
          "op": "polygon",
          "id": "L",
          "pts": [
            [
              "0",
              "0"
            ],
            [
              "d1/2",
              "0"
            ],
            [
              "d1/2",
              "l1"
            ],
            [
              "d2/2",
              "l1"
            ],
            [
              "d2/2",
              "l1+l2"
            ],
            [
              "d3/2",
              "l1+l2"
            ],
            [
              "d3/2",
              "l1+l2+l3"
            ],
            [
              "0",
              "l1+l2+l3"
            ]
          ]
        }
      ]
    },
    {
      "tool": "revolve",
      "id": "shaft",
      "say": "Revolve the profile 360 degrees about the Z axis.",
      "profile": [
        {
          "pick": "region",
          "sketch": "prof_sk",
          "curves": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "L6",
            "L7",
            "L8"
          ],
          "at": [
            5,
            0,
            5
          ]
        }
      ],
      "axis": {
        "pick": "axis",
        "name": "origin:Z"
      },
      "angle": "360 deg",
      "direction": "normal",
      "op": "new"
    },
    {
      "tool": "fillet",
      "id": "fil",
      "say": "Fillet the circular corner where the d1 shoulder meets the d2 cylinder, radius fillet_r.",
      "edges": [
        {
          "pick": "edge",
          "name": "edge(F{shaft}:side(S{prof_sk}:e(L3))|F{shaft}:side(S{prof_sk}:e(L4)))",
          "at": [
            15,
            0,
            15
          ]
        }
      ],
      "radius": "fillet_r",
      "propagate": true
    },
    {
      "tool": "chamfer",
      "id": "cham",
      "say": "Chamfer the outer edge of the end face by chamfer_c.",
      "edges": [
        {
          "pick": "edge",
          "name": "edge(F{shaft}:side(S{prof_sk}:e(L6))|F{shaft}:side(S{prof_sk}:e(L7)))",
          "at": [
            10,
            0,
            85
          ]
        }
      ],
      "mode": {
        "kind": "distance",
        "distance": "chamfer_c"
      },
      "propagate": true
    }
  ],
