{
  "name": "@whittle/ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Whittle design system: tokens, motion presets, Radix-based primitives and the adaptive app shells.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "harness": "vite --config vite.config.ts",
    "harness:build": "vite build --config vite.config.ts",
    "e2e": "playwright test --trace off",
    "e2e:update": "playwright test --trace off --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toolbar": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@whittle/contracts": "workspace:*",
    "lucide-react": "1.70.0",
    "motion": "14.10.1"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
