{
  "$id": "https://jackhale98.github.io/wren-cad/schema/wren-project.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "DocMeta": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "description": "Writer identification, e.g. `\"wren/0.1.0\"`.",
          "type": "string"
        },
        "created": {
          "description": "ISO-8601 timestamps.",
          "type": "string"
        },
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Stable document id (ULID), assigned at creation; survives renames (library identity)."
        },
        "modified": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "partNumber": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "created",
        "modified",
        "app"
      ],
      "type": "object"
    },
    "DrawingDefaults": {
      "additionalProperties": false,
      "description": "Project-wide drawing defaults (D10): set by the explicit choice at the first drawing.",
      "properties": {
        "fields": {
          "$ref": "#/definitions/TitleBlockFields",
          "description": "Title-block text every new drawing starts with (ISO 7200 legal owner, drawn by …)."
        },
        "projection": {
          "$ref": "#/definitions/Projection"
        },
        "standard": {
          "$ref": "#/definitions/DrawingStandard"
        }
      },
      "required": [
        "standard",
        "projection"
      ],
      "type": "object"
    },
    "DrawingStandard": {
      "additionalProperties": false,
      "description": "The drawing's standard family and editions (shown in the title block, used for validation).",
      "properties": {
        "family": {
          "enum": [
            "iso",
            "asme"
          ],
          "type": "string"
        },
        "generalTolerance": {
          "description": "General tolerance note, e.g. `ISO 2768-mK`; absent = none stated.",
          "type": "string"
        },
        "gps": {
          "$ref": "#/definitions/GpsStandard",
          "description": "Must belong to `family` (ISO 1101 with iso, ASME Y14.5 with asme)."
        },
        "surfaceFinish": {
          "$ref": "#/definitions/SurfaceFinishStandard"
        }
      },
      "required": [
        "family",
        "gps",
        "surfaceFinish"
      ],
      "type": "object"
    },
    "GpsStandard": {
      "description": "Standard an annotation's GD&T semantics are validated against. Stamped by the authoring tool from the drawing (or, in M5, the project default); absent on an annotation = \"not stated\", and it is then checked against each displaying drawing's standard. Never converted silently: a symbol that is illegal under the standard is refused or flagged with an explanation (ASME Y14.5-2018 has no concentricity or symmetry).",
      "enum": [
        "ISO 1101:2017",
        "ASME Y14.5-2018",
        "ASME Y14.5-2009"
      ],
      "type": "string"
    },
    "Id": {
      "description": "ULID (26-char Crockford base32).",
      "type": "string"
    },
    "ManifestEntry": {
      "additionalProperties": false,
      "description": "Index entry in the manifest: the file is keyed by the object's stable `id`, not its name.",
      "properties": {
        "file": {
          "description": "Path relative to the project root, e.g. `parts/bracket.part.json`.",
          "type": "string"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "description": "Display name (informational copy; the file is authoritative).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "file"
      ],
      "type": "object"
    },
    "Projection": {
      "enum": [
        "first",
        "third"
      ],
      "type": "string"
    },
    "SurfaceFinishStandard": {
      "description": "Surface texture standard (default ISO 21920-1; ISO 1302 is legacy, kept for old drawings).",
      "enum": [
        "ISO 21920-1:2021",
        "ISO 1302:2002",
        "ASME Y14.36-2018"
      ],
      "type": "string"
    },
    "TitleBlockFields": {
      "additionalProperties": false,
      "properties": {
        "approvedBy": {
          "type": "string"
        },
        "checkedBy": {
          "type": "string"
        },
        "configuration": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "documentStatus": {
          "type": "string"
        },
        "documentType": {
          "type": "string"
        },
        "drawnBy": {
          "type": "string"
        },
        "generalTolerance": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "mass": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "partNumber": {
          "type": "string"
        },
        "projection": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "sheet": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "units": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "description": "`wren.project.json`",
  "properties": {
    "assemblies": {
      "items": {
        "$ref": "#/definitions/ManifestEntry"
      },
      "type": "array"
    },
    "drawingDefaults": {
      "$ref": "#/definitions/DrawingDefaults",
      "description": "M4: the explicit standard and projection choice made at the first drawing."
    },
    "drawings": {
      "items": {
        "$ref": "#/definitions/ManifestEntry"
      },
      "type": "array"
    },
    "format": {
      "const": "wren-project",
      "type": "string"
    },
    "meta": {
      "$ref": "#/definitions/DocMeta"
    },
    "parts": {
      "description": "Order here is the order in the document.",
      "items": {
        "$ref": "#/definitions/ManifestEntry"
      },
      "type": "array"
    },
    "schemaVersion": {
      "type": "number"
    },
    "units": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "deg",
            "rad"
          ],
          "type": "string"
        },
        "length": {
          "enum": [
            "mm",
            "cm",
            "m",
            "in",
            "ft"
          ],
          "type": "string"
        }
      },
      "required": [
        "length",
        "angle"
      ],
      "type": "object"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "units",
    "meta",
    "parts",
    "drawings",
    "assemblies"
  ],
  "title": "ProjectManifest",
  "type": "object"
}
