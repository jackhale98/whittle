# Cloudflare Pages / Netlify-style headers (PLAN §8.2). GitHub Pages ignores this file and relies
# on the service worker (src/sw.ts) for the same COOP/COEP headers.
# `require-corp` (not `credentialless`): Safari does not support `credentialless`.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The service worker and manifest must always revalidate so updates ship promptly.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed build output is immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm
